@model Servico
@{ Layout = "_Layout"; ViewData["Title"] = Model.Nome; var profissionais=(List<Profissional>)ViewBag.Profissionais; }
<section class="content-card public-booking"><div class="brand-mark">Zlora</div><h1>@Model.Nome</h1><p>@Model.Descricao</p><p><strong>R$ @Model.Preco.ToString("N2")</strong> · @Model.DuracaoMinutos minutos</p>@if(TempData["Erro"] is string erro){<div class="notice error">@erro</div>}@if(TempData["Mensagem"] is string msg){<div class="notice">@msg</div>}<form asp-action="Agendar" method="post" class="booking-form"><input type="hidden" name="servicoId" value="@Model.Id"><input name="nome" placeholder="Seu nome" required><input name="email" type="email" placeholder="Seu e-mail" required><input name="telefone" placeholder="Seu telefone" required><select name="profissionalId" required><option value="">Escolha o profissional</option>@foreach(var p in profissionais){<option value="@p.Id">@p.NomeExibicao · @p.Horario</option>}</select><select name="dataHora" required><option value="">Horários disponíveis</option>@for(var dia=1; dia<=14; dia++){var data=DateTime.Today.AddDays(dia);foreach(var hora in new[]{9,10,11,14,15,16}){var slot=data.AddHours(hora);<option value="@slot.ToString("yyyy-MM-ddTHH:mm")">@slot.ToString("ddd, dd/MM às HH:mm")</option>}}</select><button class="btn btn-primary">Agendar atendimento</button></form><hr><h3>Cancelar um agendamento</h3><form asp-action="Cancelar" method="post" class="booking-form"><input type="hidden" name="servicoId" value="@Model.Id"><input name="email" type="email" placeholder="E-mail usado no agendamento" required><input name="dataHora" type="datetime-local" required><button class="btn btn-outline">Cancelar horário</button></form><small>Agendamentos e cancelamentos precisam ser feitos com no mínimo 24 horas de antecedência.</small></section>
