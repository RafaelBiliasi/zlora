@using Zlora.Models
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> Users
@{ ViewData["Title"] = "Visão geral"; var usuario = await Users.GetUserAsync(User); var perfis = await Users.GetRolesAsync(usuario!); var proximos = (List<Agendamento>)ViewBag.Proximos; var clientes = (List<Cliente>)ViewBag.Clientes; var servicos = (List<Servico>)ViewBag.Servicos; }
<section class="dashboard-page">
    <div class="welcome-row"><div><p class="eyebrow purple">RESUMO DA OPERAÇÃO</p><h1>Olá, @usuario!.Nome.Split(' ')[0] <span class="wave">👋</span></h1><p class="muted">Aqui está o que está acontecendo no seu estabelecimento hoje.</p></div><a class="btn btn-primary" asp-controller="Gestao" asp-action="Agenda">+ Novo agendamento</a></div>
    <div class="metric-grid">
        <article class="metric-card"><div class="metric-top"><span>Agendamentos</span><span class="metric-icon purple-bg">▦</span></div><strong>@ViewBag.TotalAgendamentos</strong><small><b class="positive">+12%</b> este mês</small><div class="sparkline purple-line"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></article>
        <article class="metric-card"><div class="metric-top"><span>Clientes</span><span class="metric-icon teal-bg">♧</span></div><strong>@ViewBag.TotalClientes</strong><small><b class="positive">+8%</b> novos cadastros</small><div class="sparkline teal-line"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></article>
        <article class="metric-card"><div class="metric-top"><span>Profissionais</span><span class="metric-icon blue-bg">♙</span></div><strong>@ViewBag.TotalProfissionais</strong><small><b class="positive">Equipe ativa</b></small><div class="sparkline blue-line"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></article>
        <article class="metric-card"><div class="metric-top"><span>Serviços ativos</span><span class="metric-icon orange-bg">✦</span></div><strong>@ViewBag.TotalServicos</strong><small><b class="neutral">Links públicos</b></small><div class="sparkline orange-line"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></article>
    </div>
    <div class="dashboard-columns">
        <article class="panel chart-panel"><div class="panel-heading"><div><h3>Movimento da agenda</h3><p>Atendimentos registrados nos últimos meses</p></div><span class="select-pill">Últimos 6 meses⌄</span></div><div class="fake-chart"><div class="chart-y"><span>30</span><span>20</span><span>10</span><span>0</span></div><div class="chart-area"><div class="chart-fill"></div><div class="chart-grid-lines"><i></i><i></i><i></i><i></i></div><div class="chart-labels"><span>Jun</span><span>Jul</span><span>Ago</span><span>Set</span><span>Out</span><span>Nov</span><span>Dez</span></div></div></div></article>
        <article class="panel channel-panel"><div class="panel-heading"><div><h3>Serviços mais procurados</h3><p>Distribuição dos agendamentos</p></div></div><div class="donut-wrap"><div class="donut-chart"><span>@ViewBag.TotalServicos</span><small>serviços</small></div><div class="legend">@foreach(var s in servicos.Take(4)){<div><i></i><span>@s.Nome</span></div>}</div></div></article>
    </div>
    <article class="panel appointments-panel"><div class="panel-heading"><div><h3>Próximos agendamentos</h3><p>Confira os atendimentos que precisam da sua atenção</p></div><a asp-controller="Gestao" asp-action="Agenda">Ver agenda completa →</a></div><div class="table-responsive"><table class="modern-table"><thead><tr><th>CLIENTE</th><th>SERVIÇO</th><th>DATA E HORÁRIO</th><th>STATUS</th></tr></thead><tbody>@if(!proximos.Any()){<tr><td colspan="4" class="empty-state">Nenhum agendamento futuro.</td></tr>}@foreach(var a in proximos){var cliente=clientes.FirstOrDefault(c=>c.Id==a.ClienteId);var servico=servicos.FirstOrDefault(s=>s.Id==a.ServicoId);<tr><td><span class="client-avatar">@(cliente?.Nome.Substring(0,1).ToUpperInvariant() ?? "C")</span><strong>@cliente?.Nome</strong></td><td>@servico?.Nome</td><td>@a.DataHoraInicio.ToLocalTime().ToString("dd MMM, HH:mm")</td><td><span class="table-status scheduled">Agendado</span></td></tr>}</tbody></table></div></article>
    <div class="future-banner"><div class="future-banner-icon">◒</div><div><strong>Financeiro e estoque em breve</strong><p>Esses módulos estão planejados para a próxima etapa da Zlora.</p></div><span>Atualização futura</span></div>
</section>
