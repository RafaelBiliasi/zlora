@model List<Servico>
@{ ViewData["Title"] = "Serviços"; var profissionais = (List<Profissional>)ViewBag.Profissionais; }
<section class="content-card wide"><div class="page-head"><div><h1>Serviços</h1><p>Crie serviços e compartilhe o link público com seus clientes.</p></div></div>
@if (User.IsInRole(Perfis.Administrador)) { <form asp-action="CriarServico" method="post" class="form-grid"><input name="Nome" placeholder="Nome do serviço" required><input name="DuracaoMinutos" type="number" value="60" min="15" placeholder="Duração (min)" required><input name="Preco" type="number" step="0.01" placeholder="Preço"><select name="ProfissionalId" required><option value="">Profissional responsável</option>@foreach(var p in profissionais){<option value="@p.Id">@p.NomeExibicao</option>}</select><input class="wide-input" name="Descricao" placeholder="Descrição"><button class="btn btn-primary">Criar serviço</button></form> }
<div class="service-grid">@foreach(var s in Model){<article class="service-card"><h3>@s.Nome</h3><p>@s.Descricao</p><strong>R$ @s.Preco.ToString("N2")</strong><div class="public-link"><small>Link público</small><input readonly value="@string.Concat(Context.Request.Scheme, "://", Context.Request.Host, "/Publico/Servico/", s.Id)" onclick="this.select()"><a class="btn btn-small" target="_blank" href="/Publico/Servico/@s.Id">Abrir</a></div></article>}</div></section>
