@model List<Agendamento>
@{ ViewData["Title"] = "Agenda"; var clientes=(List<Cliente>)ViewBag.Clientes; var profissionais=(List<Profissional>)ViewBag.Profissionais; var servicos=(List<Servico>)ViewBag.Servicos; }
<section class="content-card wide"><div class="page-head"><div><h1>Agenda</h1><p>@(User.IsInRole(Perfis.Profissional) ? "Você vê e altera somente a sua agenda." : "Visualize e organize os horários da equipe.")</p></div><a class="btn btn-outline" asp-action="Relatorio">Relatórios</a></div>
@if (User.IsInRole(Perfis.Administrador) || User.IsInRole(Perfis.Secretaria) || User.IsInRole(Perfis.Profissional)) { <form asp-action="CriarAgendamento" method="post" class="form-grid"><select name="ClienteId" required><option value="">Cliente</option>@foreach(var c in clientes){<option value="@c.Id">@c.Nome</option>}</select><select name="ServicoId" required><option value="">Serviço</option>@foreach(var s in servicos){<option value="@s.Id">@s.Nome</option>}</select>@if(!User.IsInRole(Perfis.Profissional)){<select name="ProfissionalId" required><option value="">Profissional</option>@foreach(var p in profissionais){<option value="@p.Id">@p.NomeExibicao</option>}</select>}<input name="DataHoraInicio" type="datetime-local" required><button class="btn btn-primary">Novo agendamento</button></form> }
<div class="table-responsive"><table class="table"><thead><tr><th>Data e hora</th><th>Cliente</th><th>Serviço</th><th>Status</th><th>Ações</th></tr></thead><tbody>@foreach(var a in Model){var c=clientes.FirstOrDefault(x=>x.Id==a.ClienteId);var s=servicos.FirstOrDefault(x=>x.Id==a.ServicoId);<tr><td>@a.DataHoraInicio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@c?.Nome</td><td>@s?.Nome</td><td><span class="status @a.Status">@a.Status</span></td><td><form asp-action="EditarAgendamento" method="post" class="inline-edit"><input type="hidden" name="Id" value="@a.Id"><input type="hidden" name="ProfissionalId" value="@a.ProfissionalId"><input name="DataHoraInicio" type="datetime-local" value="@a.DataHoraInicio.ToString("yyyy-MM-ddTHH:mm")" required><button class="btn btn-small">Salvar</button></form><form asp-action="Cancelar" method="post" class="inline"><input type="hidden" name="id" value="@a.Id"><button class="btn btn-danger btn-small">Cancelar</button></form></td></tr>}</tbody></table></div></section>
