@model List<Agendamento>
@{ ViewData["Title"] = "Relatório"; var clientes=(List<Cliente>)ViewBag.Clientes; var servicos=(List<Servico>)ViewBag.Servicos; var periodo=(string)ViewBag.Periodo; }
<section class="content-card wide printable"><div class="page-head"><div><h1>Histórico de atendimentos</h1><p>Período: @(periodo == "semana" ? "últimos 7 dias" : "últimos 30 dias")</p></div><div><a class="btn btn-outline" asp-action="Relatorio" asp-route-periodo="semana">Semana</a> <a class="btn btn-outline" asp-action="Relatorio" asp-route-periodo="mes">Mês</a> <a class="btn btn-primary" asp-action="RelatorioPdf" asp-route-periodo="@periodo">Baixar PDF</a></div></div><table class="table"><thead><tr><th>Data</th><th>Cliente</th><th>Serviço</th><th>Status</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.DataHoraInicio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@clientes.FirstOrDefault(c=>c.Id==a.ClienteId)?.Nome</td><td>@servicos.FirstOrDefault(s=>s.Id==a.ServicoId)?.Nome</td><td>@a.Status</td></tr>}</tbody></table></section>
